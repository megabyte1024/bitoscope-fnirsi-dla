option(BITOSCOPE_LTO "Link-time optimization of Release builds with GCC" ON)

if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
  # WHY: CMake's -flto=auto runs a job per logical CPU outside the job pool; one partition keeps -flto=1 silent.
  foreach(_bitoscope_lto_lang C CXX)
    set(CMAKE_${_bitoscope_lto_lang}_COMPILE_OPTIONS_IPO -flto=1 -flto-partition=one -fno-fat-lto-objects)
  endforeach()
endif()

function(bitoscope_optimize_own_targets dir)
  if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    return()
  endif()
  get_property(subdirs DIRECTORY "${dir}" PROPERTY SUBDIRECTORIES)
  foreach(subdir IN LISTS subdirs)
    bitoscope_optimize_own_targets("${subdir}")
  endforeach()
  get_property(targets DIRECTORY "${dir}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(target IN LISTS targets)
    get_target_property(type ${target} TYPE)
    get_target_property(imported ${target} IMPORTED)
    if(imported OR NOT type MATCHES "^(STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY|EXECUTABLE)$")
      continue()
    endif()
    get_target_property(source_dir ${target} SOURCE_DIR)
    bitoscope_is_own_source("${source_dir}/" own)
    if(NOT own)
      continue()
    endif()
    # WHY: Without it a kernel's speed depends on where its loops land: a 16-byte shift made LZ4 up to 2x slower.
    set(alignment -falign-functions=64 -falign-loops=64)
    target_compile_options(${target} PRIVATE "$<$<CONFIG:Release>:${alignment}>")
    target_link_options(${target} PRIVATE "$<$<CONFIG:Release>:${alignment}>")
    get_target_property(lto ${target} INTERPROCEDURAL_OPTIMIZATION_RELEASE)
    if(BITOSCOPE_LTO AND lto STREQUAL "lto-NOTFOUND")
      set_target_properties(${target} PROPERTIES INTERPROCEDURAL_OPTIMIZATION_RELEASE ON)
    elseif(NOT BITOSCOPE_LTO)
      # WHY: Deps hold Cap'n Proto as LTO objects: without -fno-lto GCC runs LTO on them at link time and warns.
      target_link_options(${target} PRIVATE "$<$<CONFIG:Release>:-fno-lto>")
    endif()
  endforeach()
endfunction()
